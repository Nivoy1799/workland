# Line endings: the repo stores LF. Unity writes LF on every OS, so check out text
# files as LF too; otherwise Windows (core.autocrlf=true) shows line-ending-only diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unity YAML and other text assets
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.cs text eol=lf diff=csharp
*.uss text eol=lf
*.uxml text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.bundle binary
*.unitypackage binary
*.wlt binary
