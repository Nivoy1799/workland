/* Spec 026 (D32): the warm muted palette of docs/art-direction.md, section 5, as USS variables.
   The same names as Art/Palette.cs; no other stylesheet may hold a colour value (PaletteTests). */
:root {
    --wt-cream: #F2E6D0;
    --wt-plaster: #E4D5BC;
    --wt-wood-light: #C8A27A;
    --wt-wood-dark: #8A5A3B;
    --wt-terracotta: #C8664A;
    --wt-brick: #A4503C;
    --wt-mustard: #D9A441;
    --wt-sage: #8FA77E;
    --wt-leaf: #5E7F4F;
    --wt-soft-blue: #7FA3B8;
    --wt-deep-blue: #3F5F78;
    --wt-steel: #9AA0A3;
    --wt-charcoal: #3A3532;
    --wt-ink: #2A2624;
    --wt-panel: rgba(46, 42, 39, 0.85);
    --wt-interact: #F5D27A;
}
