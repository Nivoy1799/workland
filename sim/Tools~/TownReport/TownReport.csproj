<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spec 064: the town report console tool. The "~" folder keeps Unity out; it is in no Unity assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Worktown.TownReport</AssemblyName>
    <RootNamespace>Worktown.TownReport</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Sim.csproj" />
  </ItemGroup>
</Project>
