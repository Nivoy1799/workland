<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spec 056a: writes the reachable-items file for the offline name bake. The "~" folder keeps Unity out. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Worktown.ItemList</AssemblyName>
    <RootNamespace>Worktown.ItemList</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Sim.csproj" />
  </ItemGroup>
</Project>
