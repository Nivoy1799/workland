# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ---- AI gateway (game runtime) ----
# Upstream the gateway forwards to. Switching to on-prem later = change these two lines.
GATEWAY_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
GATEWAY_UPSTREAM_API_KEY=replace-me
GATEWAY_MODEL=qwen/qwen3.8-27b

# ---- Steam ----
# 480 is Valve's public "Spacewar" test app. Use it until you have your own App ID.
STEAM_APP_ID=480

# ---- Unity (for scripts/verify.sh) ----
# Path to the Unity editor binary, enables Unity tests in verify.sh
# UNITY_PATH=/path/to/Unity/Hub/Editor/6000.x.y/Editor/Unity
