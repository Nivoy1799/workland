# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ---- AI gateway (game runtime) ----
# Upstream the gateway forwards to. Switching to on-prem later = change these two lines.
GATEWAY_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
GATEWAY_UPSTREAM_API_KEY=replace-me
GATEWAY_MODEL=qwen/qwen3.8-27b
# Bearer token the game server must send. At least 32 characters; generate one, never reuse.
GATEWAY_SERVICE_TOKEN=replace-me-with-at-least-32-random-chars
# openrouter (default) or openai (plain OpenAI-compatible, e.g. vLLM later).
GATEWAY_UPSTREAM_FLAVOR=openrouter
# Comma list for OpenRouter provider.only; empty until the smoke test picks providers.
GATEWAY_OPENROUTER_PROVIDERS=
# OpenRouter reasoning.effort; empty means the field is omitted.
GATEWAY_REASONING_EFFORT=none
GATEWAY_TEMPERATURE=0.7
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=20
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_RATE_LIMIT_BURST=30
GATEWAY_CACHE_MAX_ENTRIES=100000

# ---- Steam ----
# 480 is Valve's public "Spacewar" test app. Use it until you have your own App ID.
STEAM_APP_ID=480

# ---- Unity (for scripts/verify.sh) ----
# Path to the Unity editor binary, enables Unity tests in verify.sh
# UNITY_PATH=/path/to/Unity/Hub/Editor/6000.x.y/Editor/Unity
