<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Worktown.Gateway</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Corvus.Text.Json.Validator" Version="5.8.8" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/*.json" LogicalName="schemas.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Worktown.Gateway.Tests" />
  </ItemGroup>
</Project>
